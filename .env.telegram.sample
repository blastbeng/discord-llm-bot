# ─── Telegram Enable ─────────────────────────────────────────────
# Set to "true" to enable the Telegram bot. When "false" (default),
# the process stays alive but idle (no polling, no message processing),
# so the container remains healthy without actually running. This lets
# you keep the service in docker-compose without it actively processing.
TEL_ENABLED=false

# ─── Telegram Bot Token ──────────────────────────────────────────
# Obtain from @BotFather on Telegram.
TELOXIDE_TOKEN=your_telegram_bot_token

# ─── Chat/Group Allowlist ─────────────────────────────────────────
# Comma-separated list of chat or group IDs where the bot is allowed to
# operate. When empty/unset, ALL chats are allowed (not recommended for
# production). To find a chat/group ID, forward a message from it to
# @userinfobot or use @getidsbot.
# Example: TEL_ALLOWED_CHATS=123456789,-1001234567890
TEL_ALLOWED_CHATS=

# ─── Shared Configuration (same as Discord/WhatsApp bots) ─────────
# Database URL for SQLite (shared with the other bots)
DATABASE_URL=sqlite:config/discord-bot.sqlite3

# The language for the bot responses and TTS (ita or eng)
LANG=ita

# Log level (info, debug, error, warn, trace)
LOG_LEVEL=info

# Whether to save generated TTS MP3 files to disk for caching (true/false)
SAVE_MP3_ON_DISK=true

# Temporary directory for audio file uploads
TMP_DIR=/tmp/discord-llm-bot

# LLM configuration for the /ask command (optional)
# Uses OpenAI-compatible /v1/chat/completions endpoints
# LLM_ENDPOINTS=http://localhost:11434/v1
# LLM_API_KEYS=ollama
# LLM_MODELS=llama3.2

# ─── Voice cloning (voiceclone sidecar service) ────────────────────────────
# URL of the voiceclone sidecar. Leave empty to disable voice cloning.
# VOICECLONE_URL=http://voiceclone:3010
