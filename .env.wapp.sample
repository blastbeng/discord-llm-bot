# ─── WhatsApp Bridge ──────────────────────────────────────────────
# Port for the bridge HTTP API (default: 3001)
BRIDGE_PORT=3001

# URL where the wapp-bot webhook server is listening
# The bridge forwards incoming WhatsApp messages to this URL
WAPP_WEBHOOK_URL=http://whatsapp-bot:3002/webhook

# Comma-separated list of WhatsApp group IDs where the bot is allowed to operate.
# Format: 120363xxxxxxxx@g.us
# Leave empty to allow all groups and DMs (not recommended for production).
WHATSAPP_ALLOWED_GROUPS=

# ─── WhatsApp Bot (Rust) ──────────────────────────────────────────
# Port for the wapp-bot webhook server (default: 3002)
WAPP_WEBHOOK_PORT=3002

# URL of the WhatsApp bridge HTTP API
WAPP_BRIDGE_URL=http://whatsapp-bridge:3001

# ─── Shared Configuration (same as Discord bot) ──────────────────
# Database URL for SQLite (shared with Discord bot)
DATABASE_URL=sqlite:config/discord-bot.sqlite3

# The language for the bot responses and TTS (ita or eng)
LANG=ita

# Log level (info, debug, error, warn, trace)
LOG_LEVEL=info

# Whether to save generated TTS MP3 files to disk for caching (true/false)
SAVE_MP3_ON_DISK=true

# Temporary directory for audio file uploads
TMP_DIR=/tmp/discord-llm-bot

# FakeYou.com credentials for TTS authentication (optional)
# FAKEYOU_USERNAME=your_fakeyou_username
# FAKEYOU_PASSWORD=your_fakeyou_password

# LLM configuration for the /ask command (optional)
# Uses OpenAI-compatible /v1/chat/completions endpoints
# LLM_ENDPOINTS=http://localhost:11434/v1
# LLM_API_KEYS=ollama
# LLM_MODELS=llama3.2