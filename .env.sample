# The Discord bot token
BOT_TOKEN=your_bot_token_here

# The ID of the parent guild (server) where admin commands like /restart and /avatar are restricted
GUILD_ID=your_guild_id_here

# The Discord user ID of the bot admin
ADMIN_ID=your_discord_user_id_here

# The language for the bot responses and TTS (ita or eng)
LANG=ita

# Temporary directory for audio file uploads
TMP_DIR=/tmp/discord-llm-bot

# Set to true to save generated audios to disk and enable the background generator, false otherwise
SAVE_AUDIO=true
