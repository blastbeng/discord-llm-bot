# The Discord bot token
BOT_TOKEN=your_bot_token_here

# The ID of the parent guild (server) where admin commands like /restart and /avatar are restricted
GUILD_ID=your_guild_id_here

# The Discord user ID of the bot admin
ADMIN_ID=your_discord_user_id_here

# The language for the bot responses and TTS (ita or eng)
LANG=ita

# Database URL for SQLite (optional, defaults to sqlite:config/discord-bot.sqlite3)
# DATABASE_URL=sqlite:config/discord-bot.sqlite3

# Log level (info, debug, error, warn, trace)
LOG_LEVEL=info

# Temporary directory for audio file uploads
TMP_DIR=/tmp/discord-llm-bot

# Whether to save generated TTS MP3 files to disk for caching (true/false, default: true)
# When true, files are saved permanently in the audios/ directory with ID3 tags,
# and /random can replay cached audio without re-calling the TTS API. This also
# lets the WhatsApp bot reuse the same cache (shared volume).
# When false, TTS audio is saved to a temp file and deleted after playback.
SAVE_MP3_ON_DISK=true

# Maximum audio file size in MB for the /audio command (default: 25)
MAX_AUDIO_FILE_SIZE_MB=25

# LLM configuration for the /ask command (optional)
# Uses OpenAI-compatible /v1/chat/completions endpoints — works with Ollama
# (self-hosted, free), OpenRouter, Groq, Together AI, etc.
# All three vars must have the same number of comma-separated entries.
#
# Example with Ollama only (self-hosted, no API key needed):
# LLM_ENDPOINTS=http://localhost:11434/v1
# LLM_API_KEYS=ollama
# LLM_MODELS=llama3.2
#
# Example with OpenRouter free models:
# LLM_ENDPOINTS=https://openrouter.ai/api/v1
# LLM_API_KEYS=your_openrouter_api_key
# LLM_MODELS=meta-llama/llama-3.2-3b-instruct:free
#
# Example with multiple endpoints (rotates on rate limits):
# LLM_ENDPOINTS=http://localhost:11434/v1,https://openrouter.ai/api/v1
# LLM_API_KEYS=ollama,your_openrouter_api_key
# LLM_MODELS=llama3.2,meta-llama/llama-3.2-3b-instruct:free
# LLM_ENDPOINTS=
# LLM_API_KEYS=
# LLM_MODELS=

# --- Automatic voice-channel behaviour (optional, default: off) ---
# When enabled (true), the bot automatically joins a voice channel when a user
# enters it (if the bot has connect+speak permission and is disconnected or
# alone), switches to the channel when a user joins a different one (only if the
# bot would otherwise be left alone), and disconnects after being alone for
# AUTO_JOIN_IDLE_DISCONNECT_SECS.
# AUTO_JOIN_VOICE=false

# Whether to speak a welcome phrase when auto-joining/welcoming. The phrase is
# generated by the LLM (using the database sentences as style context) when an
# LLM is configured, otherwise a random database sentence is used. Default: true.
# AUTO_JOIN_WELCOME=true

# Seconds the bot remains alone in a voice channel before disconnecting.
# Default: 120 (2 minutes).
# AUTO_JOIN_IDLE_DISCONNECT_SECS=120

# Whether to speak a goodbye phrase when a user leaves the bot's voice
# channel. The phrase is LLM-generated when an LLM is configured, otherwise
# a random database sentence is used. Default: true.
# AUTO_JOIN_GOODBYE=true

# Whether to announce "here I am" when the bot joins a channel by itself
# (background scanner or manual /join). Default: false — when disabled the
# bot still joins the channel, it just doesn't say the announcement.
# AUTO_JOIN_HERE_I_AM=false

# --- Voice eavesdrop (optional, default: off) ---
# When enabled (true), the bot periodically "eavesdrops" on a random user in
# its voice channel and comments on what they said via LLM+TTS. Works best
# with the voiceclone sidecar running (./setup-models.sh downloads its
# models): the bot records a short snippet of live voice (songbird voice
# receive), transcribes it to text via the sidecar's whisper-tiny STT
# endpoint, and feeds the transcript + username to the LLM so the roast
# reacts to what was actually said. Without the sidecar it still roasts, but
# only based on the username. The loop checks this variable every tick, so it
# can be toggled at runtime without restarting the bot.
# VOICE_EAVESDROP_ENABLED=false

# Random interval range (seconds) between eavesdrop events: each event is
# scheduled min..max seconds after the previous one. Defaults: 300 / 1200.
# VOICE_EAVESDROP_MIN_SECS=300
# VOICE_EAVESDROP_MAX_SECS=1200

# ─── Voice cloning (voiceclone sidecar service) ────────────────────────────
# URL of the voiceclone sidecar used by all three bots. Leave empty to disable
# voice cloning entirely (the /createvoice, /myvoices, /deletevoice commands
# then respond that the feature is unavailable).
# NOTE: the Discord bot runs with network_mode: host, so from IT the sidecar
# is http://localhost:3010 (voiceclone is published on the host loopback).
# The Telegram/WhatsApp bots run on the compose network and use the alias:
#   http://voiceclone:3010
# VOICECLONE_URL=http://localhost:3010
# Owner used when speaking with a cloned voice and no user context is
# available (empty = resolve any owner with that voice name).
# VOICECLONE_SHARED_OWNER=
# ── Sidecar-only settings (voiceclone service env) ──
# Port the sidecar listens on. Default: 3010.
# VOICECLONE_PORT=3010
# Directory containing the int8 PocketTTS model (lm_flow/lm_main/encoder/
# decoder/text_conditioner/vocab.json/token_scores.json). Downloaded to
# models/pocket-tts on the host by ./setup-models.sh and bind-mounted to
# /app/models/pocket-tts by docker-compose.yml.
# VOICECLONE_MODEL_DIR=/app/models/pocket-tts
# CPU threads for generation. The Pi 5 has 4 cores; 3 leaves headroom for the
# bots (discord/telegram/wapp) sharing the same CPU. Default: 3.
# VOICECLONE_THREADS=3
# Diffusion steps per generation. 2 is the sweet spot measured on a Pi 5
# (RTF ~2.3); higher steps are slower with only marginal quality gains.
# VOICECLONE_STEPS=2
# Maximum number of stored cloned voices (each stores its reference sample in
# SQLite). Default: 24.
# VOICECLONE_MAX_VOICES=24
# Preload the model at service startup instead of on first use (slower boot,
# faster first clone). Default: false (lazy).
# VOICECLONE_PRELOAD=false
# ── STT (speech-to-text) for the Discord eavesdrop feature ──
# Directory containing the whisper-tiny int8 model (tiny-encoder.int8.onnx,
# tiny-decoder.int8.onnx, tiny-tokens.txt). Downloaded to models/whisper-tiny
# on the host by ./setup-models.sh and bind-mounted to
# /app/models/whisper-tiny by docker-compose.yml. Unset/empty disables the
# /transcribe endpoint (eavesdrop then roasts without knowing what was said).
# VOICECLONE_STT_MODEL_DIR=/app/models/whisper-tiny
# Default language hint for whisper (bot LANG codes are translated to ISO
# codes by the bots, which also pass ?lang= per request). "auto" or empty
# lets whisper auto-detect. Default: it.
# VOICECLONE_STT_LANG=it
# CPU threads for STT. whisper-tiny int8 runs at RTF ~0.26 on the Pi 5 with
# 3 threads (a 12s clip transcribes in ~3s). Default: 3.
# VOICECLONE_STT_THREADS=3
