# The Discord bot token
BOT_TOKEN=your_bot_token_here

# The ID of the parent guild (server) where admin commands like /restart and /avatar are restricted
GUILD_ID=your_guild_id_here

# The Discord user ID of the bot admin
ADMIN_ID=your_discord_user_id_here

# The language for the bot responses and TTS (ita or eng)
LANG=ita

# Database URL for SQLite (optional, defaults to sqlite:config/discord-bot.sqlite3)
# DATABASE_URL=sqlite:config/discord-bot.sqlite3

# Log level (info, debug, error, warn, trace)
LOG_LEVEL=info

# Temporary directory for audio file uploads
TMP_DIR=/tmp/discord-llm-bot

# Whether to save generated TTS MP3 files to disk for caching (true/false, default: true)
# When true, files are saved permanently in the audios/ directory with ID3 tags,
# and /random can replay cached audio without re-calling the TTS API. This also
# lets the WhatsApp bot reuse the same cache (shared volume).
# When false, TTS audio is saved to a temp file and deleted after playback.
SAVE_MP3_ON_DISK=true

# Maximum audio file size in MB for the /audio command (default: 25)
MAX_AUDIO_FILE_SIZE_MB=25

# FakeYou.com credentials for TTS authentication (optional)
# When set, the bot logs in to FakeYou on startup, which may reduce rate limiting.
# When not set, TTS requests are unauthenticated (may face stricter rate limits).
# FAKEYOU_USERNAME=your_fakeyou_username
# FAKEYOU_PASSWORD=your_fakeyou_password

# LLM configuration for the /ask command (optional)
# Uses OpenAI-compatible /v1/chat/completions endpoints — works with Ollama
# (self-hosted, free), OpenRouter, Groq, Together AI, etc.
# All three vars must have the same number of comma-separated entries.
#
# Example with Ollama only (self-hosted, no API key needed):
# LLM_ENDPOINTS=http://localhost:11434/v1
# LLM_API_KEYS=ollama
# LLM_MODELS=llama3.2
#
# Example with OpenRouter free models:
# LLM_ENDPOINTS=https://openrouter.ai/api/v1
# LLM_API_KEYS=your_openrouter_api_key
# LLM_MODELS=meta-llama/llama-3.2-3b-instruct:free
#
# Example with multiple endpoints (rotates on rate limits):
# LLM_ENDPOINTS=http://localhost:11434/v1,https://openrouter.ai/api/v1
# LLM_API_KEYS=ollama,your_openrouter_api_key
# LLM_MODELS=llama3.2,meta-llama/llama-3.2-3b-instruct:free
# LLM_ENDPOINTS=
# LLM_API_KEYS=
# LLM_MODELS=
